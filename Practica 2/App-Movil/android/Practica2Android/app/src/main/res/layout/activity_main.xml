<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:opencv="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <org.opencv.android.JavaCameraView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="518dp"
        android:layout_weight="1"
        opencv:camera_id="any"
        opencv:show_fps="true" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="@string/fps_label"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modo_vista_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/modoSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <CheckBox
            android:id="@+id/invertirCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invertir"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/alphaBlueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alpha_blue_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/alphaBlueSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/sMinText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s_min_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/sMinSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="30"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/vMinText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v_min_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/vMinSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="30"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/hMinText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hsv_hue_min_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/hMinSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="179"
                android:progress="0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/hMaxText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hsv_hue_max_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/hMaxSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="179"
                android:progress="35"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/gaussText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ruido_gaussiano_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/gaussSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="80"
                android:progress="20"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/speckleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ruido_speckle_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/speckleSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/kernelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filtro_mediana_label"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
            <SeekBar
                android:id="@+id/kernelSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="18"
                android:progress="3"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
