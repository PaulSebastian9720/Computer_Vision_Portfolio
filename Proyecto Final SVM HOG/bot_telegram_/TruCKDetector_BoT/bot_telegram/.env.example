TELEGRAM_BOT_TOKEN=coloca_tu_token_aqui
TELEGRAM_CHAT_ID=coloca_tu_chat_id_aqui

# YOLOv8 de segmentacion. Si no existe localmente, Ultralytics puede descargarlo.
YOLO_MODEL_NAME=yolov8n-seg.pt

# El HOG+SVM principal lo ejecuta C++.
# Activar esto solo si tambien quieren que Python recalcule HOG con un .yml local.
HOG_ENABLED=0
HOG_MODEL_PATH=../../targets/camiones_nuevovision/models/detector_lateral_latest.yml
HOG_THRESHOLD=auto
